DISCORD_TOKEN=paste_your_bot_token_here
# Optional: your server ID for immediate server-only slash command registration.
# Leave empty to register slash commands globally.
DISCORD_GUILD_ID=
# Plain messages need Message Content Intent enabled in the Developer Portal.
TEXT_COMMANDS=true

